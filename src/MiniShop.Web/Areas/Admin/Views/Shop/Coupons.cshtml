@model List<Coupon>
<h1>@L["Coupons"]</h1>
@if(TempData["Error"] is string error){<p role="alert" class="error">@L[error]</p>}
<div class="coupon-admin-grid">@foreach(var coupon in Model.Append(new Coupon{ExpiresAt=DateTime.UtcNow.AddMonths(1)})){<section class="card"><h2>@(coupon.Id==0?L["NewCoupon"].Value:coupon.Code)</h2><form asp-action="SaveCoupon" method="post"><input type="hidden" name="Id" value="@coupon.Id"/><label>@L["Coupon"]<input name="Code" value="@coupon.Code" required pattern="[A-Za-z0-9_-]{3,24}" maxlength="24"/></label><div class="two-cols"><label>@L["Percent"]<input type="number" name="Percent" min="1" max="90" value="@(coupon.Id==0?10:coupon.Percent)" required/></label><label>@L["MinimumSpend"]<input type="number" name="MinimumSpend" min="0" max="1000000" step="0.01" value="@coupon.MinimumSpend.ToString(System.Globalization.CultureInfo.InvariantCulture)" required/></label></div><label>@L["Expires"]<input name="ExpiresAt" type="datetime-local" value="@coupon.ExpiresAt.ToString("yyyy-MM-ddTHH:mm")" required/></label><label class="checkbox-label"><input type="checkbox" name="IsActive" value="true" checked="@coupon.IsActive"/>@L["Active"]</label><input type="hidden" name="IsActive" value="false"/><button>@L["SaveChanges"]</button></form></section>}</div>
