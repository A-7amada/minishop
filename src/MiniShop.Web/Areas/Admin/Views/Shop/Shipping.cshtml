@using MiniShop.Domain.Entities
@{var zones=(List<ShippingZone>)ViewBag.Zones;var regions=(List<ShippingRegion>)ViewBag.Regions;var st=(ShippingSettings)ViewBag.Settings;var ar=System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var inv=System.Globalization.CultureInfo.InvariantCulture;}
<h1>@L["ShippingConfig"]</h1><p class="demo-note">@L["ShippingAdminNote"]</p>
@if(TempData["Error"] is string error){<p role="alert" class="error">@L[error]</p>}
@if(TempData["Saved"] is string saved){<p class="saved-note" role="status">✓ @L[saved]</p>}
<section class="card" id="cod-settings"><h2>@L["CodSettings"]</h2><form asp-action="SaveSettings" method="post"><div class="two-cols"><label>@L["CodFee"] (EGP)<input type="number" name="CodFee" min="0" max="100000" step="0.01" value="@st.CodFee.ToString("0.##",inv)" required/></label><label>@L["CodMaxOrder"]<input type="number" name="CodMaxOrder" min="0" max="10000000" step="0.01" value="@st.CodMaxOrder.ToString("0.##",inv)" required/></label></div><label class="checkbox-label"><input type="checkbox" name="CodEnabled" value="true" checked="@st.CodEnabled"/>@L["CodEnabled"]</label><input type="hidden" name="CodEnabled" value="false"/><button>@L["SaveChanges"]</button></form></section>
<h2>@L["Zones"]</h2>
<div class="coupon-admin-grid">@foreach(var z in zones.Append(new ShippingZone{Name="",NameAr="",Fee=50,FreeThreshold=1000})){<section class="card"><h2>@(z.Id==0?L["NewZone"].Value:(ar?z.NameAr:z.Name))</h2><form asp-action="SaveZone" method="post"><input type="hidden" name="Id" value="@z.Id"/><div class="two-cols"><label>@L["ZoneName"] (EN)<input name="Name" value="@z.Name" required maxlength="60"/></label><label>@L["ZoneName"] (AR)<input name="NameAr" value="@z.NameAr" required maxlength="60" dir="rtl"/></label></div><div class="two-cols"><label>@L["ZoneFee"]<input type="number" name="Fee" min="0" max="100000" step="0.01" value="@z.Fee.ToString("0.##",inv)" required/></label><label>@L["FreeThreshold"]<input type="number" name="FreeThreshold" min="0" max="1000000" step="0.01" value="@z.FreeThreshold.ToString("0.##",inv)" required/></label></div><div class="two-cols"><label>@L["MinDays"]<input type="number" name="MinDays" min="0" max="60" value="@z.MinDays" required/></label><label>@L["MaxDays"]<input type="number" name="MaxDays" min="0" max="60" value="@z.MaxDays" required/></label></div><label class="checkbox-label"><input type="checkbox" name="IsActive" value="true" checked="@z.IsActive"/>@L["Active"]</label><input type="hidden" name="IsActive" value="false"/><button>@L["SaveChanges"]</button></form>@if(z.Id!=0){<p class="demo-note">@regions.Count(r=>r.ZoneId==z.Id) @L["Governorates"]</p>}</section>}</div>
<section class="card"><h2>@L["Governorates"]</h2><div class="region-grid">@foreach(var r in regions.OrderBy(x=>x.Name)){<form asp-action="SetRegion" method="post" class="region-row"><input type="hidden" name="regionId" value="@r.Id"/><span>@(ar?r.NameAr:r.Name)</span><select name="zoneId" aria-label="@L["Zone"]">@foreach(var z in zones){<option value="@z.Id" selected="@(z.Id==r.ZoneId)">@(ar?z.NameAr:z.Name)</option>}</select><button>@L["Update"]</button></form>}</div></section>
