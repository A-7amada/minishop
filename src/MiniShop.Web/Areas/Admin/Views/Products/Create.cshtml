@model Product
<h1>@L["AddProduct"]</h1>
<div class="form-card">
<form method="post">
    <label>@L["Name"]</label>
    <input asp-for="Name" />
    <label>@L["NameArLabel"]</label>
    <input asp-for="NameAr" dir="rtl" />
    <label>@L["Description"]</label>
    <textarea asp-for="Description" rows="3"></textarea>
    <label>@L["DescriptionArLabel"]</label>
    <textarea asp-for="DescriptionAr" rows="3" dir="rtl"></textarea>
    <label>@L["PriceEGP"]</label>
    <input asp-for="Price" type="number" step="0.01" min="0.01" />
    <label>@L["Stock"]</label>
    <input asp-for="Stock" type="number" min="0" />
    <label>@L["EmojiLabel"]</label>
    <input asp-for="Emoji" />
    <button class="btn-block" type="submit">@L["Create"]</button>
</form>
</div>
