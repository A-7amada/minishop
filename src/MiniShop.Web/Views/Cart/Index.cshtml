@model List<CartLine>
@{ var isAr = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar"; }
<h1>@L["CartTitle"]</h1>
@if (Model.Count == 0)
{
    <p>@L["CartEmpty"] <a asp-controller="Home" asp-action="Index">@L["BrowseProducts"]</a></p>
}
else
{
    <table>
        <tr><th>@L["Product"]</th><th>@L["Price"]</th><th>@L["Qty"]</th><th>@L["Subtotal"]</th><th></th></tr>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.LocalizedName(isAr)</td>
                <td>@l.Price.ToString("0.00") EGP</td>
                <td><form class="quantity-form" asp-action="Update" method="post"><input type="hidden" name="id" value="@l.ProductId"/><input aria-label="@L["Qty"]" type="number" min="1" max="100000" name="quantity" value="@l.Quantity"/><button>@L["Update"]</button></form></td>
                <td>@l.Subtotal.ToString("0.00") EGP</td>
                <td>
                    <form class="inline" asp-action="Remove" asp-route-id="@l.ProductId" method="post">
                        <button class="btn-danger" type="submit">@L["Remove"]</button>
                    </form>
                </td>
            </tr>
        }
    </table>
    <div class="total-row">
        <span>@L["Total"]</span>
        <span class="price">@Model.Sum(l => l.Subtotal).ToString("0.00") EGP</span>
    </div>
    <a class="btn" asp-controller="Checkout" asp-action="Index">@L["ProceedToCheckout"]</a>
}
