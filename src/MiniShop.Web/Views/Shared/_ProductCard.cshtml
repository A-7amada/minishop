@model Product
@inject MiniShop.Application.Services.ShopService Shop
@{var ar=System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var saved=User.Identity?.IsAuthenticated==true && (await Shop.WishlistAsync(User.Identity.Name!)).Contains(Model.Id);}
<article class="product"><div class="product-image"><a href="/Home/Details/@Model.Id"><img src="/images/@(Model.Artwork).svg" alt="@Model.LocalizedName(ar)" loading="lazy"/></a><form asp-area="" asp-controller="Wishlist" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/><button class="wish-button @(saved?"saved":"")" aria-label="@L["Save"]" aria-pressed="@saved.ToString().ToLowerInvariant()">@(saved?"♥":"♡")</button></form><span class="category-label">@L[Model.Category]</span></div><div class="product-info"><h3><a href="/Home/Details/@Model.Id">@Model.LocalizedName(ar)</a></h3><p class="desc">@Model.LocalizedDescription(ar)</p><div class="product-bottom"><p class="price">@Model.Price.ToString("N0") <small>EGP</small></p><span class="stock">@(Model.Stock>0?L["InStock",Model.Stock]:L["OutOfStock"])</span></div><form asp-area="" asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" method="post"><button class="add-button" disabled="@(Model.Stock==0)">@L["AddToCart"] <span>+</span></button></form></div></article>
