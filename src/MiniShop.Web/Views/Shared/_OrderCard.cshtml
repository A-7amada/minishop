@model Order
@{var ar=System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";var steps=new[]{"Confirmed","Processing","Shipped","Delivered"};var index=Array.IndexOf(steps,Model.Status);}
<article class="card order-card"><div class="order-top"><h2>#@Model.Id</h2><span>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</span><strong class="price">@Model.Total.ToString("N2") EGP</strong></div>@if(Model.Status=="Cancelled"){<p class="error cancelled-badge">@L["Cancelled"]</p>}<ol class="tracking">@for(var i=0;i<steps.Length;i++){<li class="@(i<=index?"done":"")"><span>@(i+1)</span>@L[steps[i]]</li>}</ol><p class="demo-note">@L["DemoTracking"]</p>@if(!string.IsNullOrEmpty(Model.AddressLine)){<p class="order-meta">@Model.FullName · @Model.AddressLine, @Model.City, @(ar?Model.GovernorateAr:Model.Governorate)<br/>@L["Shipping"]: @(Model.ShippingFee==0?L["FreeLabel"].Value:Model.ShippingFee.ToString("N2")+" EGP")@if(Model.CodFee>0){<span> · @L["CodFee"]: @Model.CodFee.ToString("N2") EGP</span>}<br/>@L["PaymentMethod"]: @(Model.PaymentMethod=="COD"?L["PayCodOption"]:L["PayMockOption"]) · <strong>@L[Model.PaymentStatus]</strong></p>}<ul>@foreach(var line in Model.Lines){<li>@(ar&&!string.IsNullOrEmpty(line.ProductNameAr)?line.ProductNameAr:line.ProductName) × @line.Quantity</li>}</ul>@if(Model.Discount>0){<p class="discount">@L["Coupon"]: @Model.CouponCode · -@Model.Discount.ToString("N2") EGP</p>}</article>
