<h1>@L["LoginTitle"]</h1>
<div class="form-card">
    @if (ViewBag.Error != null) { <p class="error">@ViewBag.Error</p> }
    <form method="post">
        <label>@L["Email"]</label>
        <input type="email" name="email" required />
        <label>@L["Password"]</label>
        <input type="password" name="password" required />
        <button class="btn-block" type="submit">@L["Login"]</button>
    </form>
    <p style="margin-bottom:0;">@L["NoAccount"] <a asp-action="Register">@L["Register"]</a></p>
</div>
