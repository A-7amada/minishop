@model List<Order>
<p class="eyebrow">MINISHOP / @L["MyOrders"]</p><h1>@L["OrdersTitle"]</h1>
@if(Model.Count==0){<p class="empty-state">@L["NoOrdersYet"]</p>}
@if(TempData["Error"] is string error){<p class="error" role="alert">@L[error]</p>}
@foreach(var order in Model){@await Html.PartialAsync("_OrderCard",order)@if(order.Status=="Confirmed"){<form asp-controller="Account" asp-action="Cancel" asp-route-id="@order.Id" method="post" class="cancel-form" onsubmit="return confirm('@L["CancelConfirm"]')"><button class="text-button">@L["CancelOrder"] #@order.Id</button></form>}}
