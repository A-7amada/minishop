@model List<Product>
@{var isAr=System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";}
<section class="hero"><div class="hero-copy"><p class="eyebrow">@L["Collection"] <span> / 01</span></p><h1>@L["HeroTitle"]</h1><p>@L["HeroSubtitle"]</p><a class="btn" href="#products">@L["HeroCta"] <span>↗</span></a><div class="hero-note"><span class="tiny-line"></span>@L["DemoNotice"]</div></div><a class="hero-visual" href="/Home/Details/4" aria-label="@L["Audio"]"><div class="orbit"></div><span class="visual-label">MINISHOP / AUDIO</span><img src="/images/headphones.svg" alt="@(isAr?"رسم توضيحي لسماعات الرأس":"Illustration of over-ear headphones")"/><div class="visual-bottom"><strong>@L["HeroCaption"]</strong><small>@L["HeroMini"]</small></div><span class="round-arrow">↗</span></a></section>
<section class="features"><div><span>◇</span><section><strong>@L["FeatureOne"]</strong><small>@L["FeatureOneSub"]</small></section></div><div><span>♡</span><section><strong>@L["FeatureTwo"]</strong><small>@L["FeatureTwoSub"]</small></section></div><div><span>✧</span><section><strong>@L["FeatureThree"]</strong><small>@L["FeatureThreeSub"]</small></section></div></section>
<section id="products"><div class="section-title"><div><p class="eyebrow">@L["Curated"]</p><h2>@L["CatalogTitle"]</h2></div><p>@Model.Count @L["Results"]</p></div>
<form class="filter-bar" method="get" action="/#products"><input type="hidden" name="q" value="@ViewBag.Query"/><label for="category">@L["Products"]</label><select id="category" name="category">@foreach(var c in new[]{"","Desk","Audio","Displays"}){<option value="@c" selected="@(ViewBag.Category==c)">@L[string.IsNullOrEmpty(c)?"All":c]</option>}</select><label for="sort">@L["Sort"]</label><select id="sort" name="sort"><option value="">@L["Featured"]</option><option value="low" selected="@(ViewBag.Sort=="low")">@L["LowHigh"]</option><option value="high" selected="@(ViewBag.Sort=="high")">@L["HighLow"]</option></select><button class="subtle-btn">@L["ApplyFilters"]</button></form>
@if(Model.Count==0){<div class="empty-state">@L["NoResults"]</div>}
<div class="grid">@foreach(var product in Model){@await Html.PartialAsync("_ProductCard",product)}</div></section>
