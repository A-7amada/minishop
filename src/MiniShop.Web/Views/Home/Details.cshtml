@model Product
@{var ar=System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName=="ar";}
<p class="breadcrumb"><a href="/">@L["Products"]</a> / @Model.LocalizedName(ar)</p><section class="detail-grid"><div class="detail-image"><img src="/images/@(Model.Artwork).svg" alt="@Model.LocalizedName(ar)"/></div><div class="detail-copy"><p class="eyebrow">@L[Model.Category]</p><h1>@Model.LocalizedName(ar)</h1><p>@Model.LocalizedDescription(ar)</p><p class="price">@Model.Price.ToString("N0") EGP</p><p class="stock">@L["InStock",Model.Stock]</p><form asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" method="post"><button disabled="@(Model.Stock==0)">@L["AddToCart"]</button></form><form asp-controller="Wishlist" asp-action="Toggle" method="post"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><button class="subtle-btn">♡ @L["Wishlist"]</button></form><p class="demo-note">@L["DemoNotice"]</p></div></section>
